{
  "name": "RetailPulse_Daily_Medallion_ETL_Job",
  "email_notifications": {
    "on_failure": ["data-alerts@retailpulse.com"],
    "on_success": []
  },
  "timeout_seconds": 3600,
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "01_batch_ingest_bronze",
      "notebook_task": {
        "notebook_path": "notebooks/01_bronze/01_batch_ingest_copy_into",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 600,
      "max_retries": 2,
      "min_retry_interval_millis": 30000
    },
    {
      "task_key": "02_streaming_ingest_autoloader",
      "depends_on": [
        {
          "task_key": "01_batch_ingest_bronze"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/01_bronze/02_streaming_ingest_autoloader",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 600
    },
    {
      "task_key": "03_clean_customers_silver",
      "depends_on": [
        {
          "task_key": "01_batch_ingest_bronze"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/02_silver/01_clean_customers",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 600
    },
    {
      "task_key": "04_clean_products_silver",
      "depends_on": [
        {
          "task_key": "01_batch_ingest_bronze"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/02_silver/02_clean_products",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 600
    },
    {
      "task_key": "05_clean_orders_and_quarantine_silver",
      "depends_on": [
        {
          "task_key": "03_clean_customers_silver"
        },
        {
          "task_key": "04_clean_products_silver"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/02_silver/03_clean_orders_and_quarantine",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 600
    },
    {
      "task_key": "06_clean_streaming_events_silver",
      "depends_on": [
        {
          "task_key": "02_streaming_ingest_autoloader"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/02_silver/04_clean_streaming_events",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 600
    },
    {
      "task_key": "07_build_gold_star_schema",
      "depends_on": [
        {
          "task_key": "05_clean_orders_and_quarantine_silver"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/03_gold/01_build_star_schema_dims_facts",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 600
    },
    {
      "task_key": "08_build_gold_kpi_marts",
      "depends_on": [
        {
          "task_key": "07_build_gold_star_schema"
        }
      ],
      "notebook_task": {
        "notebook_path": "notebooks/03_gold/02_agg_kpi_business_metrics",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 600
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "Asia/Kolkata",
    "pause_status": "UNPAUSED"
  }
}

